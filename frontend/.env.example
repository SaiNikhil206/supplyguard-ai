# Mock mode (MSW): unset = ON in `npm run dev`, OFF in production builds.
# Set explicitly to "true" or "false" to override.
#   VITE_API_MOCK=true    -> MSW fixtures, no backend needed (demo123 users: admin/manager/viewer)
#   VITE_API_MOCK=false   -> REAL Django backend. `npm run dev` proxies /api to VITE_PROXY_TARGET
#                            (default http://localhost:8000); log in with the seeded demo users
#                            (python manage.py load_seed --demo-users -> acme.admin, acme.procurement, acme.viewer;
#                            password = DEMO_USER_PASSWORD used when seeding).
# VITE_API_MOCK=false
VITE_API_BASE_URL=/api/v1
# Dev-server proxy target for /api (only used by `npm run dev`).
# VITE_PROXY_TARGET=http://localhost:8000
